# Example overrides. printf, varargs and file-scope state are permitted in
# example firmware. Header diagnostics use the including translation unit's
# configuration, so pico-sh2's magic-number override is repeated here.
InheritParentConfig: true

Checks: >
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -readability-magic-numbers,

# cppcoreguidelines-pro-type-vararg: printf is the console. Its arguments are
# the harness's own counters and timings.
#
# cppcoreguidelines-avoid-non-const-global-variables: SDK callbacks take no
# context pointer. Static transports permit bus selection without allocation
# (AR-1).
#
# readability-magic-numbers: literals are harness parameters and transcribed
# wire fields in pico-sh2 headers.
