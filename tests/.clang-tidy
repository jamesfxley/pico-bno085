# Library-owned test-tree overrides layered on the pinned root .clang-tidy.
#
# Each rule below is a standing deviation registered in this
# repository's docs/deviations.md, one row per directory this file takes effect
# in. The name must be the canonical check, never an alias: the root config
# disables aliases in favour of their canonical spelling, so an alias here
# suppresses nothing while reading as if it does.
InheritParentConfig: true

Checks: >
  -readability-magic-numbers

# Literal sizes, offsets, counts and timestamps in a test are the case under
# test, not a value shared with production code; hoisting each to a named
# constant moves the expected value away from the assertion that reads it.
